{
    "manifest_version": 3,
    "name": "Hei Matau",
    "version": "2.0",
    "description": "Blocks external links on protected sites and shows the destination, clean link, and risk signals.",
    "permissions": ["storage"],
    "background": { "service_worker": "background.js" },
    "options_ui": { "page": "options.html", "open_in_tab": true },
    "content_scripts": [
    {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["url-core.js", "content.js"],
        "run_at": "document_start",
        "all_frames": true,
        "match_origin_as_fallback": true
    }
    ],
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Hei Matau: settings",
        "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
    },
    "web_accessible_resources": [
        { "resources": ["icons/48.png"], "matches": ["http://*/*", "https://*/*"] }
    ]
}
