{
    "manifest_version": 3,
    "name": "Link Guard",
    "version": "1.1",
    "description": "Sui domini in lista blocca i link verso altri domini e mostra l'URL non cliccabile.",
    "permissions": ["storage"],
    "background": { "service_worker": "background.js" },
    "options_ui": { "page": "options.html", "open_in_tab": true },
    "content_scripts": [
    {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["content.js"],
        "run_at": "document_start",
        "all_frames": true,
        "match_origin_as_fallback": true
    }
    ],
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Link Guard: impostazioni",
        "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
    },
    "web_accessible_resources": [
        { "resources": ["icons/48.png"], "matches": ["http://*/*", "https://*/*"] }
    ]
}
